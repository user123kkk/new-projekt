  {
   "start": 0.0,
   "end": 1.96,
   "text": "We humans are absolutely impatient."
  },
  {
   "start": 3.06,
   "end": 4.94,
   "text": "By nature, we want immediate rewards."
  },
  {
   "start": 5.68,
   "end": 8.06,
   "text": "Instead of waiting for future, even bigger rewards."
  },
  {
   "start": 9.02,
   "end": 10.46,
   "text": "Do you want $1 million now?"
  },
  {
   "start": 10.76,
   "end": 12.52,
   "text": "Or $10 million when you are 70?"
  },
  {
   "start": 13.200000000000001,
   "end": 15.72,
   "text": "The majority of us will go with the immediate reward."
  },
  {
   "start": 16.66,
   "end": 18.88,
   "text": "That's the same principle most brands use on us,"
  },
  {
   "start": 19.080000000000002,
   "end": 20.98,
   "text": "and what you can use for your business too."
  },
  {
   "start": 21.92,
   "end": 25.42,
   "text": "Sell the instant benefit, not the long-term outcome."
  },
  {
   "start": 26.240000000000002,
   "end": 28.88,
   "text": "Lose weight in 30 days sounds better than"
  },
  {
   "start": 28.88,
   "end": 31.0,
   "text": "avoid health issues in 20 years."
  },
  {
   "start": 31.2,
   "end": 34.7,
   "text": "If you want more sales, make tomorrow's benefits appear today,"
  },
  {
   "start": 35.04,
   "end": 36.08,
   "text": "because..."
  }
 ]
